# Frontend variables: configure these in Vercel for Production and Preview.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key
VITE_MAX_TRIP_YEARS=2

# Supabase Edge Function secrets: do not configure these in Vercel.
AERODATABOX_RAPIDAPI_KEY=your-rapidapi-key
AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com/
